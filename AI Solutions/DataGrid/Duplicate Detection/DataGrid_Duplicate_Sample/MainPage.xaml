             xmlns:models="clr-namespace:DataGrid_Duplicate_Sample.Models"
             x:Class="DataGrid_Duplicate_Sample.MainPage"
             x:DataType="local:ViewModel"
             Title="Customer Duplicate Detection"
             BackgroundColor="White">

    <Grid Padding="0"
          RowDefinitions="Auto,*"
          RowSpacing="0">

        <!-- ====== HEADER + ACTION CARD ====== -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20,20,20,12"
                             Spacing="16">

            <!-- ====== HEADER ====== -->
            <!--<VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border BackgroundColor="#EEF2FF"
