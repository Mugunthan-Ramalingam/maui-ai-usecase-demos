                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditStatusCompleted}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <StackLayout Orientation="Horizontal" Spacing="5">
                                            <Label Text="&#xE876;" FontFamily="MaterialIcons" FontSize="12" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                                            <Label Text="Completed" FontSize="12" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditStatusCompleted}" Value="True">
                                                        <Setter Property="TextColor" Value="#16A34A"/><Setter Property="FontAttributes" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditStatusCompleted}" Value="False">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Border>
                                    <Border Padding="14,8" StrokeThickness="1.5" StrokeShape="RoundRectangle 20">
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectEditStatusCommand}" CommandParameter="Pending"/></Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditStatusPending}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FEF3C7"/><Setter Property="Stroke" Value="#D97706"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditStatusPending}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="Pending" FontSize="12">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEditStatusPending}" Value="True">
                                                    <Setter Property="TextColor" Value="#D97706"/><Setter Property="FontAttributes" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEditStatusPending}" Value="False">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <Border Padding="14,8" StrokeThickness="1.5" StrokeShape="RoundRectangle 20">
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectEditStatusCommand}" CommandParameter="Scheduled"/></Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditStatusScheduled}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FEF3C7"/><Setter Property="Stroke" Value="#B45309"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditStatusScheduled}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="Scheduled" FontSize="12">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEditStatusScheduled}" Value="True">
                                                    <Setter Property="TextColor" Value="#B45309"/><Setter Property="FontAttributes" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEditStatusScheduled}" Value="False">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </HorizontalStackLayout>
                            </StackLayout>

                            <!-- Notes -->
                            <StackLayout Spacing="6">
                                <Label Text="Notes" FontSize="12" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDarkAlt}}"/>
                                <til:SfTextInputLayout ContainerType="Outlined" OutlineCornerRadius="10"
                                                       EnableFloating="False"
                                                       FocusedStrokeThickness="1.5"
                                                       UnfocusedStrokeThickness="1.5"
                                                       Hint="Optional notes"
                                                       InputViewPadding="14,0"
                                                       ReserveSpaceForAssistiveLabels="False"
                                                       Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3D2E24}"
                                                       ContainerBackground="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyMid}}">
                                    <til:SfTextInputLayout.HintLabelStyle>
                                        <til:LabelStyle FontSize="14" TextColor="#94A3B8"/>
                                    </til:SfTextInputLayout.HintLabelStyle>
                                    <Entry Text="{Binding EditServiceNotes}"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"
                                           BackgroundColor="Transparent"/>
                                </til:SfTextInputLayout>
                            </StackLayout>

                        </StackLayout>
                    </ScrollView>

                    <!-- Footer -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="24,14,24,24"
                          BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}">
                        <BoxView Grid.ColumnSpan="2" HeightRequest="1" VerticalOptions="Start"
                                 BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}" Margin="0,0,0,14"/>
                        <buttons:SfButton Grid.Column="0" Text="Cancel" HeightRequest="44"
                                          Background="{AppThemeBinding Light=#FAF9F5, Dark=#1A2D3D}"
                                          TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                          FontSize="14" FontAttributes="Bold" CornerRadius="10" StrokeThickness="0"
                                          Command="{Binding CancelEditServiceCommand}"/>
                        <buttons:SfButton Grid.Column="1" Text="Save" HeightRequest="44"
                                          Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                          TextColor="White" FontSize="14" FontAttributes="Bold"
                                          CornerRadius="10" StrokeThickness="0"
                                          Command="{Binding SaveServiceCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsEditFuelDrawerVisible}" ZIndex="1100">
            <BoxView BackgroundColor="#B2000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelEditFuelCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border HorizontalOptions="{OnPlatform WinUI=End, MacCatalyst=End, Default=Fill}"
                    WidthRequest="{OnPlatform WinUI=480, MacCatalyst=480}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SplashBgLight}, Dark={StaticResource BrandNavy}}"
                    StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="0"/></Border.StrokeShape>
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- SfDatePicker dialog -->
                    <picker:SfDatePicker x:Name="EditFuelDatePicker" Mode="Dialog"
                                         Grid.RowSpan="3"
                                         SelectedDate="{Binding EditFuelDate}"
                                         OkButtonClicked="OnEditFuelDateOkClicked">
                        <picker:SfDatePicker.HeaderView>
                            <picker:PickerHeaderView Text="Select Fuel Date" Height="40"/>
                        </picker:SfDatePicker.HeaderView>
                        <picker:SfDatePicker.FooterView>
                            <picker:PickerFooterView ShowOkButton="True" CancelButtonText="Cancel" Height="40"/>
                        </picker:SfDatePicker.FooterView>
                    </picker:SfDatePicker>

                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="24,16"
                          BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}">
                        <StackLayout Spacing="2">
                            <Label Text="Fuel Log" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandMutedOnLight}, Dark={StaticResource BrandMutedOnDark}}"/>
                            <Label Text="Edit Fuel Entry" FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"/>
                        </StackLayout>
                        <Border Grid.Column="1" WidthRequest="32" HeightRequest="32"
                                BackgroundColor="{AppThemeBinding Light=#FAF9F5, Dark=#2D2117}"
                                StrokeThickness="0" VerticalOptions="Start">
                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelEditFuelCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xE5CD;" FontFamily="MaterialIcons" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                        </Border>
                    </Grid>

                    <!-- Form -->
                    <ScrollView Grid.Row="1" Padding="24,16"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyMid}}">
                        <StackLayout Spacing="18">

                            <!-- Fuel Type chips (1�4) -->
                            <StackLayout Spacing="8">
                                <Label Text="Fuel Type" FontSize="12" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDarkAlt}}"/>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" Padding="6,10" StrokeThickness="1.5" StrokeShape="RoundRectangle 10">
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectEditFuelTypeCommand}" CommandParameter="Petrol"/></Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditFuelPetrolSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FEE2E2"/><Setter Property="Stroke" Value="#DC2626"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditFuelPetrolSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <StackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="Petrol" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditFuelPetrolSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#DC2626"/><Setter Property="FontAttributes" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditFuelPetrolSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="6,10" StrokeThickness="1.5" StrokeShape="RoundRectangle 10">
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectEditFuelTypeCommand}" CommandParameter="Diesel"/></Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditFuelDieselSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#D1FAE5"/><Setter Property="Stroke" Value="#065F46"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditFuelDieselSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <StackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="Diesel" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditFuelDieselSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#065F46"/><Setter Property="FontAttributes" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditFuelDieselSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="6,10" StrokeThickness="1.5" StrokeShape="RoundRectangle 10">
                                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectEditFuelTypeCommand}" CommandParameter="CNG"/></Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditFuelCNGSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#FEF3C7"/><Setter Property="Stroke" Value="#D97706"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEditFuelCNGSelected}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <StackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="CNG" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditFuelCNGSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#D97706"/><Setter Property="FontAttributes" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsEditFuelCNGSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </StackLayout>
                                    </Border>
                                </Grid>
                            </StackLayout>

                            <!-- Date + Station (2 cols) -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="DATE" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDarkAlt}}"/>
                                    <Grid>
                                        <til:SfTextInputLayout Hint="Select date">
                                            <til:SfTextInputLayout.HintLabelStyle>
                                                <til:LabelStyle FontSize="14" TextColor="#94A3B8"/>
                                            </til:SfTextInputLayout.HintLabelStyle>
                                            <Entry Text="{Binding EditFuelDateDisplay}" IsReadOnly="True"
                                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"
                                                   BackgroundColor="Transparent"/>
                                        </til:SfTextInputLayout>
                                        <Label Text="&#xE916;" FontFamily="MaterialIcons" FontSize="18"
                                               VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,14,0"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                               InputTransparent="True"/>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditFuelDateFieldTapped"/>
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </StackLayout>
                                <StackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="STATION" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDarkAlt}}"/>
                                    <til:SfTextInputLayout ContainerType="Outlined" OutlineCornerRadius="10"
                                                           EnableFloating="False"
                                                           FocusedStrokeThickness="1.5"
                                                           UnfocusedStrokeThickness="1.5"
                                                           Hint="HP Petrol Bunk" InputViewPadding="14,0"
                                                           ReserveSpaceForAssistiveLabels="False"
                                                           Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3D2E24}"
                                                           ContainerBackground="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyMid}}">
                                        <til:SfTextInputLayout.HintLabelStyle>
                                            <til:LabelStyle FontSize="14" TextColor="#94A3B8"/>
                                        </til:SfTextInputLayout.HintLabelStyle>
                                        <Entry Text="{Binding EditFuelStation}"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"
                                               BackgroundColor="Transparent"/>
                                    </til:SfTextInputLayout>
                                </StackLayout>
                            </Grid>

                            <!-- Litres + Cost per Litre (2 cols) -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackLayout Spacing="6">
                                    <Label Text="LITRES FILLED" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDarkAlt}}"/>
                                    <til:SfTextInputLayout ContainerType="Outlined" OutlineCornerRadius="10"
                                                           EnableFloating="False"
                                                           FocusedStrokeThickness="1.5"
                                                           UnfocusedStrokeThickness="1.5"
                                                           Hint="42.5" InputViewPadding="14,0"
                                                           ReserveSpaceForAssistiveLabels="False"
                                                           Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3D2E24}"
                                                           ContainerBackground="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyMid}}">
                                        <til:SfTextInputLayout.HintLabelStyle>
                                            <til:LabelStyle FontSize="14" TextColor="#94A3B8"/>
                                        </til:SfTextInputLayout.HintLabelStyle>
                                        <Entry Text="{Binding EditFuelLitres}" Keyboard="Numeric"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"
                                               BackgroundColor="Transparent"/>
                                    </til:SfTextInputLayout>
                                </StackLayout>
                                <StackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="₹ COST PER LITRE" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDarkAlt}}"/>
                                    <til:SfTextInputLayout ContainerType="Outlined" OutlineCornerRadius="10"
                                                           EnableFloating="False"
                                                           FocusedStrokeThickness="1.5"
                                                           UnfocusedStrokeThickness="1.5"
                                                           Hint="104.50" InputViewPadding="14,0"
                                                           ReserveSpaceForAssistiveLabels="False"
                                                           Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3D2E24}"
                                                           ContainerBackground="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyMid}}">
                                        <til:SfTextInputLayout.HintLabelStyle>
                                            <til:LabelStyle FontSize="14" TextColor="#94A3B8"/>
                                        </til:SfTextInputLayout.HintLabelStyle>
                                        <Entry Text="{Binding EditFuelCostPerLitre}" Keyboard="Numeric"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"
                                               BackgroundColor="Transparent"/>
                                    </til:SfTextInputLayout>
                                </StackLayout>
                            </Grid>

                            <!-- Total Cost card -->
                            <Border BackgroundColor="{AppThemeBinding Light=#F0F9FF, Dark=#0D2035}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light=#BAE6FD, Dark=#3D2E24}"
                                    StrokeShape="RoundRectangle 12" Padding="16,14">
                                <StackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="Total Cost" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#0284C7, Dark=#7DD3FC}"/>
                                    <Label Text="{Binding EditFuelTotalCostDisplay}" FontSize="28" FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#0C4A6E, Dark=#EDF6FF}"/>
                                </StackLayout>
                            </Border>

                            <!-- Odometer -->
                            <StackLayout Spacing="6">
                                <Label Text="ODOMETER READING (KM)" FontSize="12" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandTextMid}, Dark={StaticResource BrandTextOnDarkAlt}}"/>
                                <til:SfTextInputLayout ContainerType="Outlined" OutlineCornerRadius="10"
                                                       EnableFloating="False"
                                                       FocusedStrokeThickness="1.5"
                                                       UnfocusedStrokeThickness="1.5"
                                                       Hint="45,280" InputViewPadding="14,0"
                                                       ReserveSpaceForAssistiveLabels="False"
                                                       Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3D2E24}"
                                                       ContainerBackground="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyMid}}">
                                    <til:SfTextInputLayout.HintLabelStyle>
                                        <til:LabelStyle FontSize="14" TextColor="#94A3B8"/>
                                    </til:SfTextInputLayout.HintLabelStyle>
                                    <Entry Text="{Binding EditFuelOdometer}" Keyboard="Numeric"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandTextDark}, Dark={StaticResource BrandTextOnDark}}"
                                           BackgroundColor="Transparent"/>
                                </til:SfTextInputLayout>
                            </StackLayout>

                        </StackLayout>
                    </ScrollView>

                    <!-- Footer -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="24,14,24,24"
                          BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource BrandNavyLight}}">
                        <BoxView Grid.ColumnSpan="2" HeightRequest="1" VerticalOptions="Start"
                                 BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}" Margin="0,0,0,14"/>
                        <buttons:SfButton Grid.Column="0" Text="Cancel" HeightRequest="44"
                                          Background="{AppThemeBinding Light=#FAF9F5, Dark=#1A2D3D}"
                                          TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                          FontSize="14" FontAttributes="Bold" CornerRadius="10" StrokeThickness="0"
                                          Command="{Binding CancelEditFuelCommand}"/>
                        <buttons:SfButton Grid.Column="1" Text="Save" HeightRequest="44"
                                          Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                          TextColor="White" FontSize="14" FontAttributes="Bold"
                                          CornerRadius="10" StrokeThickness="0"
                                          Command="{Binding SaveFuelCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentView>
                        

