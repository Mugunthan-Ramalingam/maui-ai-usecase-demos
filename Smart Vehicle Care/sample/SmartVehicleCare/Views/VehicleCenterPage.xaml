<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
             xmlns:treeView="clr-namespace:Syncfusion.Maui.TreeView;assembly=Syncfusion.Maui.TreeView"
             xmlns:calendar="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
             xmlns:charts="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:combo="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:dataGrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:scheduler="clr-namespace:Syncfusion.Maui.Scheduler;assembly=Syncfusion.Maui.Scheduler"
             xmlns:maps="clr-namespace:Syncfusion.Maui.Maps;assembly=Syncfusion.Maui.Maps"
             xmlns:vm="clr-namespace:SmartVehicleCare.ViewModels"
             xmlns:models="clr-namespace:SmartVehicleCare.Models"
             xmlns:views="clr-namespace:SmartVehicleCare.Views"
             xmlns:til="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
             x:Class="SmartVehicleCare.Views.VehicleCenterPage"
             BackgroundColor="{AppThemeBinding Light=#FAF9F5, Dark=#111009}">

    <!-- BindingContext set here so the IsVisible on this element in MainPage.xaml
         still resolves against the inherited MainViewModel. -->
    <Grid RowDefinitions="*"
          x:Name="RootGrid">
        <Grid.BindingContext>
            <vm:VehicleCenterViewModel/>
        </Grid.BindingContext>

        <Grid.Resources>
            <!-- Map pin marker shown on the tile layer for each nearby place -->
            <DataTemplate x:Key="NearbyMarkerTemplate">
                <StackLayout IsClippedToBounds="False" HorizontalOptions="Start" VerticalOptions="Start" HeightRequest="30">
                    <Label Text="📍" FontSize="22" HorizontalOptions="Start" VerticalOptions="Start"/>
                </StackLayout>
            </DataTemplate>

            <!-- Tooltip shown when a marker is tapped -->
            <DataTemplate x:Key="NearbyTooltipTemplate">
                <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8" WidthRequest="200">
                    <StackLayout Spacing="3">
                        <Label Text="{Binding DataItem.Name}"    FontSize="12" FontAttributes="Bold" TextColor="White"   LineBreakMode="WordWrap"/>
                        <Label Text="{Binding DataItem.Details}" FontSize="10" TextColor="#94A3B8"   LineBreakMode="WordWrap"/>
                        <Label Text="{Binding DataItem.Address}" FontSize="10" TextColor="#64748B"   LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Border>
            </DataTemplate>
        </Grid.Resources>


        
        <tabView:SfTabView x:Name="VehicleTabView"
                           Grid.Row="0"
                           BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                           IndicatorBackground="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                           IndicatorPlacement="Bottom"
                           SelectedIndex="0"
                           TabWidthMode="SizeToContent">

        
            <tabView:SfTabItem Header="Maintenance"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource BrandMutedOnLight}, Dark={StaticResource BrandMutedOnDark}}">
                <tabView:SfTabItem.Content>
                    <ScrollView BackgroundColor="{AppThemeBinding Light=#FAF9F5, Dark=#111009}">
                        <StackLayout Padding="16,18,16,22" Spacing="18">

                            <!-- KPI Cards: 1x4 on Windows, 2x2 on Mobile -->
                            <Grid ColumnSpacing="12" RowSpacing="12"
                                  ColumnDefinitions="{OnPlatform WinUI='*,*,*,*', Default='*,*'}"
                                  RowDefinitions="{OnPlatform WinUI='Auto', Default='Auto,Auto'}">

                                <!-- TOTAL SERVICES -->
                                <Border Grid.Column="{OnPlatform WinUI=0, Default=0}" Grid.Row="{OnPlatform WinUI=0, Default=0}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="14,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="88">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackLayout Spacing="5">
                                            <Label Text="TOTAL SERVICES" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                            <Label Text="{Binding TotalServices}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#2D2117}"
                                                StrokeThickness="0" VerticalOptions="Start">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE8D0;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F59E0B}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- LAST SERVICE -->
                                <Border Grid.Column="{OnPlatform WinUI=1, Default=1}" Grid.Row="{OnPlatform WinUI=0, Default=0}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="14,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="88">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackLayout Spacing="5">
                                            <Label Text="LAST SERVICE" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                            <Label Text="{Binding LastServiceText}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F7D37B}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#FEF9C3, Dark=#2A200A}"
                                                StrokeThickness="0" VerticalOptions="Start">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE889;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F7D37B}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- TOTAL SPENT -->
                                <Border Grid.Column="{OnPlatform WinUI=2, Default=0}" Grid.Row="{OnPlatform WinUI=0, Default=1}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="14,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="88">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackLayout Spacing="5">
                                            <Label Text="TOTAL SPENT" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                            <Label Text="{Binding LifetimeSpend}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#2D2117}"
                                                StrokeThickness="0" VerticalOptions="Start">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE227;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F59E0B}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- NEXT SERVICE DUE -->
                                <Border Grid.Column="{OnPlatform WinUI=3, Default=1}" Grid.Row="{OnPlatform WinUI=0, Default=1}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        Padding="14,12" StrokeShape="RoundRectangle 16"
                                        MinimumHeightRequest="88">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackLayout Spacing="4">
                                            <Label Text="NEXT SERVICE DUE" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#7A94AA}"/>
                                            <Label Text="{Binding NextServiceDays}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#059669, Dark=#6EE7B7}"/>
                                            <Label Text="{Binding NextServiceDetail}" FontSize="10"
                                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                        </StackLayout>
                                        <Border Grid.Column="1" WidthRequest="34" HeightRequest="34"
                                                BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#0A2A1E}"
                                                StrokeThickness="0" VerticalOptions="Start">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="&#xE425;" FontFamily="MaterialIcons" FontSize="16"
                                                   TextColor="{AppThemeBinding Light=#059669, Dark=#6EE7B7}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,460" ColumnSpacing="14" HeightRequest="204"
                                  IsVisible="{OnPlatform WinUI=True, MacCatalyst=True, Default=False}">

                                <!-- Service Log -->
                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        StrokeShape="RoundRectangle 16" Padding="0">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <StackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="18,14,18,10" ColumnSpacing="10">
                                            <Label Text="Service Log" FontSize="16" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                            <buttons:SfButton Grid.Column="2" Text="+ Add Service"
                                                                FontSize="12" FontAttributes="Bold"
                                                                HeightRequest="32" CornerRadius="8"
                                                                Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                                                TextColor="White" StrokeThickness="0"
                                                                Command="{Binding AddServiceCommand}"/>
                                            <buttons:SfButton Grid.Column="1" Text="View all"
                                                             IsVisible="{Binding HasServiceHistory}"
                                                             FontSize="11" FontAttributes="Bold"
                                                             HeightRequest="30" CornerRadius="8"
                                                             Background="Transparent"
                                                             TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                                                             StrokeThickness="0"
                                                             Command="{Binding ShowServiceLogDetailsCommand}"/>
                                            
                                        </Grid>
                                        <BoxView BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}" HeightRequest="1"/>
                                        <StackLayout IsVisible="{Binding NoServiceHistory}" Padding="16,32" Spacing="8" HorizontalOptions="Center">
                                            <Label Text="&#xE8D0;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A3D5C}"/>
                                            <Label Text="No service records yet" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                                            <Label Text="Click + Add Service to log your first service" FontSize="12" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#4A6580}"/>
                                        </StackLayout>
                                        <dataGrid:SfDataGrid x:Name="ServiceHistoryGrid"
                                                             IsVisible="{Binding HasServiceHistory}"
                                                             ItemsSource="{Binding VisibleServiceHistory}"
                                                             AutoGenerateColumnsMode="None"
                                                             AllowEditing="False"
                                                             SortingMode="Single"
                                                             SelectionMode="None"
                                                             NavigationMode="Row"
                                                             HorizontalOverScrollMode="None"
                                                             VerticalOverScrollMode="None"
                                                             AllowDiagonalScrolling="False"
                                                             HorizontalScrollBarVisibility="Never"
                                                             VerticalScrollBarVisibility="Never"
                                                             GridLinesVisibility="Horizontal"
                                                             HeaderGridLinesVisibility="Horizontal"
                                                             ColumnWidthMode="Fill"
                                                             HeaderRowHeight="{OnPlatform WinUI=32, MacCatalyst=32, Android=42, iOS=42}"
                                                             RowHeight="{OnPlatform WinUI=38, MacCatalyst=38, Android=42,iOS=42}"
                                                             HeightRequest="220">
                                            <dataGrid:SfDataGrid.DefaultStyle>
                                                <dataGrid:DataGridStyle
                                                    HeaderRowBackground="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                    HeaderRowTextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                    RowBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                    RowTextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                    GridLineColor="{AppThemeBinding Light=#E2E8F0, Dark=#193752}"/>
                                            </dataGrid:SfDataGrid.DefaultStyle>
                                            <dataGrid:SfDataGrid.Columns>
                                                <dataGrid:DataGridTextColumn MappingName="Date" HeaderText="DATE" Width="140"/>
                                                <dataGrid:DataGridTextColumn MappingName="ServiceType" HeaderText="SERVICE TYPE" Width="180" LineBreakMode="WordWrap"/>
                                                <dataGrid:DataGridTextColumn MappingName="Mileage" HeaderText="ODOMETER" Width="140"/>
                                                <dataGrid:DataGridTextColumn MappingName="Amount" HeaderText="COST" Width="120"/>
                                                <dataGrid:DataGridTemplateColumn MappingName="Status" HeaderText="STATUS" Width="140">
                                                    <dataGrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="models:ServiceRecord">
                                                            <ContentView HorizontalOptions="Center" VerticalOptions="Center">
                                                                <Border BackgroundColor="{Binding StatusBgColor}"
                                                                        Padding="8,3" StrokeThickness="0"
                                                                        HorizontalOptions="Center" VerticalOptions="Center">
                                                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                                                    <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="10" FontAttributes="Bold"/>
                                                                </Border>
                                                            </ContentView>
                                                        </DataTemplate>
                                                    </dataGrid:DataGridTemplateColumn.CellTemplate>
                                                </dataGrid:DataGridTemplateColumn>
                                                <dataGrid:DataGridTemplateColumn HeaderText="" Width="72">
                                                    <dataGrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="models:ServiceRecord">
                                                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                                                <Label Text="&#xE3C9;" FontFamily="MaterialIcons" FontSize="18"
                                                                       TextColor="{AppThemeBinding Light=#B45309, Dark=#D97706}" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.EditServiceCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                                <Label Text="&#xE872;" FontFamily="MaterialIcons" FontSize="18"
                                                                       TextColor="#EF4444" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.DeleteServiceCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                        </DataTemplate>
                                                    </dataGrid:DataGridTemplateColumn.CellTemplate>
                                                </dataGrid:DataGridTemplateColumn>
                                            </dataGrid:SfDataGrid.Columns>
                                        </dataGrid:SfDataGrid>
                                    </StackLayout>
                                </Border>

                                <!-- Fuel Spending (desktop right panel) -->
                                <Border Grid.Column="1" 
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                        StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                        StrokeShape="RoundRectangle 16" Padding="0">
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                    <StackLayout Spacing="0">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="16,12,16,10" ColumnSpacing="10">
                                            <StackLayout Orientation="Horizontal" Spacing="6">
                                                <Label Text="&#xE889;" FontFamily="MaterialIcons" FontSize="16" TextColor="{AppThemeBinding Light=#B45309, Dark=#F59E0B}" VerticalOptions="Center"/>
                                                <Label Text="Fuel Spending" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                            </StackLayout>
                                            
                                            <buttons:SfButton Grid.Column="2" Text="+ Add Fuel"
                                                             FontSize="11" FontAttributes="Bold"
                                                             HeightRequest="30" CornerRadius="8"
                                                             Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                                             TextColor="White" StrokeThickness="0"
                                                             Command="{Binding AddFuelCommand}"/>
                                            <buttons:SfButton Grid.Column="1" Text="View all"
                                                             IsVisible="{Binding HasFuelEntries}"
                                                             FontSize="10" FontAttributes="Bold"
                                                             HeightRequest="28" CornerRadius="8"
                                                             Background="Transparent"
                                                             TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                                                             StrokeThickness="0"
                                                             Command="{Binding ShowFuelSpendingDetailsCommand}"/>
                                        </Grid>
                                        <BoxView BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}" HeightRequest="1"/>
                                        <StackLayout IsVisible="{Binding NoFuelEntries}" Padding="16,24" Spacing="8" HorizontalOptions="Center">
                                            <Label Text="&#xE889;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A3D5C}"/>
                                            <Label Text="No fuel records yet" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                                            <Label Text="Tap + Add Fuel to log your first fill-up" FontSize="11" HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#4A6580}"/>
                                        </StackLayout>
                                        <dataGrid:SfDataGrid IsVisible="{Binding HasFuelEntries}"
                                                             ItemsSource="{Binding VisibleFuelEntries}"
                                                             AutoGenerateColumnsMode="None"
                                                             SelectionMode="None"
                                                             AllowEditing="False"
                                                             HorizontalScrollBarVisibility="Never"
                                                             VerticalScrollBarVisibility="Never"
                                                             GridLinesVisibility="Horizontal"
                                                             HeaderGridLinesVisibility="Horizontal"
                                                             ColumnWidthMode="Fill"
                                                             HeaderRowHeight="{OnPlatform WinUI=32, MacCatalyst=32, Android=42, iOS=42}"
                                                             RowHeight="{OnPlatform WinUI=40, MacCatalyst=40, Android=42,iOS=42}"
                                                             HeightRequest="220">
                                            <dataGrid:SfDataGrid.DefaultStyle>
                                                <dataGrid:DataGridStyle HeaderRowBackground="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                                        HeaderRowTextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                                        RowBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                                        RowTextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                                        GridLineColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                                            </dataGrid:SfDataGrid.DefaultStyle>
                                            <dataGrid:SfDataGrid.Columns>
                                                <dataGrid:DataGridTextColumn MappingName="Date" HeaderText="DATE" Width="160"/>
                                                <dataGrid:DataGridTextColumn MappingName="FuelType" HeaderText="TYPE" Width="150"/>
                                                <dataGrid:DataGridTextColumn MappingName="TotalCostDisplay" HeaderText="COST" Width="140"/>
                                                <dataGrid:DataGridTemplateColumn HeaderText="" Width="72">
                                                    <dataGrid:DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="models:FuelEntry">
                                                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                                                <Label Text="&#xE3C9;" FontFamily="MaterialIcons" FontSize="18"
                                                                       TextColor="{AppThemeBinding Light=#B45309, Dark=#D97706}" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.EditFuelCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                                <Label Text="&#xE872;" FontFamily="MaterialIcons" FontSize="18"
                                                                       TextColor="#EF4444" VerticalOptions="Center">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.DeleteFuelCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                        </DataTemplate>
                                                    </dataGrid:DataGridTemplateColumn.CellTemplate>
                                                </dataGrid:DataGridTemplateColumn>
                                            </dataGrid:SfDataGrid.Columns>
                                        </dataGrid:SfDataGrid>
                                    </StackLayout>
                                </Border>
                            </Grid>

                            <Border IsVisible="{OnPlatform WinUI=False, MacCatalyst=False, Default=True}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                    StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                    StrokeShape="RoundRectangle 16" Padding="0">
                                <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}" Offset="0,8" Radius="14" Opacity="0.18"/></Border.Shadow>
                                <StackLayout Spacing="0">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="16,12,16,10" ColumnSpacing="6">
                                        <Label Text="Service Log" FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                        <buttons:SfButton Grid.Column="1" Text="View all"
                                                         IsVisible="{Binding HasServiceHistory}"
                                                         FontSize="10" FontAttributes="Bold"
                                                         HeightRequest="28" CornerRadius="8"
                                                         Background="Transparent"
                                                         TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"
                                                         StrokeThickness="0"
                                                         Command="{Binding ShowServiceLogDetailsCommand}"/>
                                        <buttons:SfButton Grid.Column="2" Text="+ Add"
                                                         FontSize="10" FontAttributes="Bold"
                                                         HeightRequest="28" CornerRadius="8"
                                                         Background="{AppThemeBinding Light=#B45309, Dark=#D97706}"
                                                         TextColor="White" StrokeThickness="0"
                                                         Command="{Binding AddServiceCommand}"/>
                                    </Grid>
                                    <BoxView BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}" HeightRequest="1"/>
                                    <StackLayout IsVisible="{Binding NoServiceHistory}" Padding="16,24" Spacing="8" HorizontalOptions="Center">
                                        <Label Text="&#xE8D0;" FontFamily="MaterialIcons" FontSize="32" HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A3D5C}"/>
                                        <Label Text="No service records yet" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"/>
                                        <Label Text="Tap + Add to log your first service" FontSize="11" HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#94A3B8, Dark=#4A6580}"/>
                                    </StackLayout>
                                    <dataGrid:SfDataGrid IsVisible="{Binding HasServiceHistory}"
                                                         ItemsSource="{Binding VisibleServiceHistory}"
                                                         AutoGenerateColumnsMode="None"
                                                         SelectionMode="None"
                                                         AllowEditing="False"
                                                         AllowDiagonalScrolling="False"
                                                         HorizontalScrollBarVisibility="Never"
                                                         VerticalScrollBarVisibility="Never"
                                                         GridLinesVisibility="Horizontal"
                                                         HeaderGridLinesVisibility="Horizontal"
                                                         ColumnWidthMode="Fill"
                                                         HeaderRowHeight="44"
                                                         RowHeight="52"
                                                         HeightRequest="220">
                                        <dataGrid:SfDataGrid.DefaultStyle>
                                            <dataGrid:DataGridStyle HeaderRowBackground="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                                    HeaderRowTextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                                    RowBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                                    RowTextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                                    GridLineColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
