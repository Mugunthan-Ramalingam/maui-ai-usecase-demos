                                                        </Border.Triggers>
                                                        <Label Text="Week" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsWeekViewActive}" Value="True">
                                                                    <Setter Property="TextColor" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsWeekViewActive}" Value="False">
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                    <!-- Day -->
                                                    <Border Padding="14,7" StrokeThickness="1"
                                                            Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#3D2E24}"
                                                            StrokeShape="RoundRectangle 0,8,8,0">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding SetDayViewCommand}"/>
                                                        </Border.GestureRecognizers>
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsDayViewActive}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="#B45309"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding IsDayViewActive}" Value="False">
                                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"/>
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Label Text="Day" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsDayViewActive}" Value="True">
                                                                    <Setter Property="TextColor" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsDayViewActive}" Value="False">
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"/>
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <BoxView BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                     HeightRequest="1"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,10" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F1E2D}">
                                                <Border WidthRequest="32" HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent"
                                                        StrokeShape="RoundRectangle 10">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPreviousMonthTapped"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#xE5CB;" FontFamily="MaterialIcons" FontSize="18"
                                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>

                                                <Label Grid.Column="1"
                                                       Text="{Binding CurrentMonthDisplayDate, StringFormat='{0:MMMM yyyy}'}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>

                                                <Border Grid.Column="2" WidthRequest="32" HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="Transparent"
                                                        StrokeShape="RoundRectangle 10">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnNextMonthTapped"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="&#xE5CC;" FontFamily="MaterialIcons" FontSize="18"
                                                           TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                            </Grid>
                                            <!-- SfScheduler with month view by default -->
                                            <scheduler:SfScheduler x:Name="ScheduleCalendar"
                                                View="{Binding CurrentSchedulerView}"
                                                AppointmentsSource="{Binding ServiceAppointments}"
                                                HeightRequest="{OnPlatform WinUI=480, Default=380}"
                                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                CellBorderBrush="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"
                                                ShowTodayButton="False"
                                                ShowNavigationArrows="False">
                                                <scheduler:SfScheduler.Triggers>
                                                    <DataTrigger TargetType="scheduler:SfScheduler"
                                                                 Binding="{Binding CurrentSchedulerView}"
                                                                 Value="Day">
                                                        <Setter Property="CellBorderBrush" Value="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="scheduler:SfScheduler"
                                                                 Binding="{Binding CurrentSchedulerView}"
                                                                 Value="Week">
                                                        <Setter Property="CellBorderBrush" Value="{AppThemeBinding Light=#E5E0D8, Dark=#3D2E24}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="scheduler:SfScheduler"
                                                                 Binding="{Binding CurrentSchedulerView}"
                                                                 Value="Month">
                                                        <Setter Property="CellBorderBrush" Value="{AppThemeBinding Light=transparent, Dark=#3D2E24}"/>
                                                    </DataTrigger>
                                                </scheduler:SfScheduler.Triggers>
                                                <scheduler:SfScheduler.DaysView>
                                                    <scheduler:SchedulerDaysView StartHour="8" EndHour="18"
                                                                                 TimeIntervalHeight="60">
                                                        <scheduler:SchedulerDaysView.ViewHeaderSettings>
                                                            <scheduler:SchedulerViewHeaderSettings Background="{AppThemeBinding Light=#EAF3FB, Dark=#122C45}">
                                                                <scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#475569, Dark=#A9C4DA}"
                                                                                                 FontSize="12"
                                                                                                 FontAttributes="Bold"/>
                                                                </scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                                <scheduler:SchedulerViewHeaderSettings.DateTextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                                                                 FontSize="16"
                                                                                                 FontAttributes="Bold"/>
                                                                </scheduler:SchedulerViewHeaderSettings.DateTextStyle>
                                                            </scheduler:SchedulerViewHeaderSettings>
                                                        </scheduler:SchedulerDaysView.ViewHeaderSettings>
                                                        <scheduler:SchedulerDaysView.TimeRulerTextStyle>
                                                            <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                                                         FontSize="11"/>
                                                        </scheduler:SchedulerDaysView.TimeRulerTextStyle>
                                                    </scheduler:SchedulerDaysView>
                                                </scheduler:SfScheduler.DaysView>
                                                <scheduler:SfScheduler.MonthView>
                                                    <scheduler:SchedulerMonthView AppointmentDisplayMode="Text">
                                                        <scheduler:SchedulerMonthView.ViewHeaderSettings>
                                                            <scheduler:SchedulerViewHeaderSettings DayFormat="ddd"
                                                                                                  Background="{AppThemeBinding Light=#EAF3FB, Dark=#122C45}">
                                                                <scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#475569, Dark=#A9C4DA}"
                                                                                                 FontSize="12"
                                                                                                 FontAttributes="Bold"/>
                                                                </scheduler:SchedulerViewHeaderSettings.DayTextStyle>
                                                            </scheduler:SchedulerViewHeaderSettings>
                                                        </scheduler:SchedulerMonthView.ViewHeaderSettings>
                                                        <scheduler:SchedulerMonthView.CellStyle>
                                                            <scheduler:SchedulerMonthCellStyle Background="{AppThemeBinding Light=#FAF9F5, Dark=#1C1917}"
                                                                                              LeadingMonthBackground="{AppThemeBinding Light=#FAF9F5, Dark=#1C1917}"
                                                                                              TrailingMonthBackground="{AppThemeBinding Light=#FAF9F5, Dark=#1C1917}">
                                                                <scheduler:SchedulerMonthCellStyle.TextStyle>
                                                                    <scheduler:SchedulerTextStyle TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                                                                 FontSize="12"/>
                                                                </scheduler:SchedulerMonthCellStyle.TextStyle>
                                                            </scheduler:SchedulerMonthCellStyle>
                                                        </scheduler:SchedulerMonthView.CellStyle>
                                                    </scheduler:SchedulerMonthView>
                                                </scheduler:SfScheduler.MonthView>
                                                <scheduler:SfScheduler.HeaderView>
                                                    <scheduler:SchedulerHeaderView Height="0"/>
                                                </scheduler:SfScheduler.HeaderView>
                                            </scheduler:SfScheduler>
                                        </StackLayout>
                                    </Border>

                                    <!-- Mobile-only: Schedule Intelligence below calendar -->
                                    <StackLayout IsVisible="{OnPlatform WinUI=False, MacCatalyst=False, Default=True}"
                                                 Spacing="14">
                                        <Label Text="Schedule Intelligence" FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>

                                        <!-- Empty state when no schedules added (mobile) -->
                                        <Border IsVisible="{Binding NoScheduleAlerts}"
                                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="14">
                                            <StackLayout Spacing="6" HorizontalOptions="Center" Padding="0,8">
                                            <Label Text="&#xE425;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A3D5C}"/>
                                                <Label Text="No reminders yet" FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="Tap &quot;+ Add Schedule&quot; to create your first reminder." FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                            </StackLayout>
                                        </Border>

                                        <!-- Upcoming Alerts (mobile) -->
                                        <Border IsVisible="{Binding HasScheduleAlerts}"
                                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="14">
                                            <StackLayout Spacing="10">
                                                <StackLayout Orientation="Horizontal" Spacing="6">
                                                    <Label Text="&#xE002;" FontFamily="MaterialIcons" FontSize="15" TextColor="{AppThemeBinding Light=#F59E0B, Dark=#FCD34D}" VerticalOptions="Center"/>
                                                    <Label Text="Upcoming Alerts" FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <StackLayout BindableLayout.ItemsSource="{Binding ScheduleAlerts}"
                                                             Spacing="10">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ScheduleAlert">
                                                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                                    StrokeThickness="0"
                                                                    StrokeShape="RoundRectangle 10"
                                                                    Padding="0">
                                                                <Grid ColumnDefinitions="4,*">
                                                                    <BoxView BackgroundColor="{Binding LeftAccentColor}"
                                                                             HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                                                    <StackLayout Grid.Column="1" Spacing="3" Padding="10,8">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                                            <Border BackgroundColor="{Binding BadgeBgColor}"
                                                                                    Padding="6,2" StrokeThickness="0">
                                                                                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                                                <Label Text="{Binding Badge}"
                                                                                       TextColor="{Binding BadgeColor}"
                                                                                       FontSize="9" FontAttributes="Bold"/>
                                                                            </Border>
                                                                            <Label Grid.Column="2" Text="{Binding Date}"
                                                                                   FontSize="10"
                                                                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#7A94AA}"
                                                                                   VerticalOptions="Center"/>
                                                                        </Grid>
                                                                        <Label Text="{Binding Title}" FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                                                        <Label Text="{Binding Description}" FontSize="11"
                                                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                                               LineBreakMode="WordWrap"/>
                                                                    </StackLayout>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </StackLayout>
                                            </StackLayout>
                                        </Border>

                                        <!-- Predictive Service (mobile) -->
                                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="14">
                                            <StackLayout Spacing="10">
                                                <StackLayout Orientation="Horizontal" Spacing="10">
                                                    <Border BackgroundColor="#0D9488"
                                                            WidthRequest="32" HeightRequest="32"
                                                            StrokeThickness="0">
                                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                                        <Label Text="+" FontSize="16" TextColor="White"
                                                               FontAttributes="Bold"
                                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                    <Label Text="Predictive Service" FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding PredictiveServiceDate}" FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark={StaticResource BrandBlueBright}}"/>
                                                <Label Text="{Binding PredictiveServiceDescription}" FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                       LineBreakMode="WordWrap"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="Current Mileage" FontSize="12"
                                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Column="1" Text="{Binding PredictiveMileage}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </StackLayout>
                                        </Border>
                                    </StackLayout>

                                </StackLayout>
                            </ScrollView>

                            <!-- Schedule Intelligence panel (desktop right column) -->
                            <ScrollView Grid.Column="1"
                                        IsVisible="{OnPlatform WinUI=True, MacCatalyst=True, Default=False}">
                                <StackLayout Spacing="14" Padding="0,0,0,4">

                                    <!-- Schedule Intelligence panel (desktop right column) -->
                                    <Label Text="Schedule Intelligence" FontSize="16" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>

                                    <!-- Empty state (desktop) -->
                                    <Border IsVisible="{Binding NoScheduleAlerts}"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="20">
                                        <StackLayout Spacing="8" HorizontalOptions="Center" Padding="0,10">
                                            <Label Text="&#xE425;" FontFamily="MaterialIcons" FontSize="36" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#CBD5E1, Dark=#2A3D5C}"/>
                                            <Label Text="No reminders added" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Use &quot;+ Add Schedule&quot; to create service reminders." FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Border>

                                    <!-- Upcoming Alerts card (desktop) -->
                                    <Border IsVisible="{Binding HasScheduleAlerts}"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}"
                                                    Offset="0,4" Radius="12" Opacity="0.14"/>
                                        </Border.Shadow>
                                        <StackLayout Spacing="14">
                                            <StackLayout Orientation="Horizontal" Spacing="8">
                                                <Label Text="&#xE002;" FontFamily="MaterialIcons" FontSize="16" TextColor="{AppThemeBinding Light=#F59E0B, Dark=#FCD34D}" VerticalOptions="Center"/>
                                                <Label Text="Upcoming Alerts" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                            <StackLayout BindableLayout.ItemsSource="{Binding ScheduleAlerts}"
                                                         Spacing="12">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ScheduleAlert">
                                                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 10"
                                                                Padding="0">
                                                            <Grid ColumnDefinitions="4,*">
                                                                <BoxView BackgroundColor="{Binding LeftAccentColor}"
                                                                         HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                                                <StackLayout Grid.Column="1" Spacing="5" Padding="12,10">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                        <Border BackgroundColor="{Binding BadgeBgColor}"
                                                                                Padding="6,2" StrokeThickness="0">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="4"/>
                                                                            </Border.StrokeShape>
                                                                            <Label Text="{Binding Badge}"
                                                                                   TextColor="{Binding BadgeColor}"
                                                                                   FontSize="9" FontAttributes="Bold"/>
                                                                        </Border>
                                                                        <Label Grid.Column="2" Text="{Binding Date}"
                                                                               FontSize="11"
                                                                               TextColor="{AppThemeBinding Light=#94A3B8, Dark=#7A94AA}"
                                                                               VerticalOptions="Center"/>
                                                                    </Grid>
                                                                    <Label Text="{Binding Title}" FontSize="13"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"/>
                                                                    <Label Text="{Binding Description}" FontSize="12"
                                                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                                           LineBreakMode="WordWrap"/>
                                                                </StackLayout>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </StackLayout>
                                        </StackLayout>
                                    </Border>

                                    <!-- Predictive Service card (desktop) -->
                                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="{AppThemeBinding Light=#94A3B8, Dark=#020B14}"
                                                    Offset="0,4" Radius="12" Opacity="0.14"/>
                                        </Border.Shadow>
                                        <StackLayout Spacing="12">
                                            <StackLayout Orientation="Horizontal" Spacing="10">
                                                <Border BackgroundColor="#0D9488"
                                                        WidthRequest="36" HeightRequest="36"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                                    <Label Text="+" FontSize="20" TextColor="White"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                                <Label Text="Predictive Service" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                            <Label Text="{Binding PredictiveServiceDate}" FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#F59E0B}"/>
                                            <Label Text="{Binding PredictiveServiceDescription}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                   LineBreakMode="WordWrap"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="Current Mileage" FontSize="12"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#9DB7D2}"
                                                       VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding PredictiveMileage}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </StackLayout>
                                    </Border>

                                </StackLayout>
                            </ScrollView>
                        </Grid>
                    </Grid>
                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>

        </tabView:SfTabView>

        <popup:SfPopup IsOpen="{Binding IsServiceLogPopupVisible}"
                       HeaderTitle="Service Log"
                       ShowHeader="True"
                       ShowFooter="False"
                       Margin="12"
                       ShowCloseButton="True"
                       WidthRequest="760"
                       HeightRequest="{Binding ServiceLogPopupHeight}"
                       StaysOpen="False">
            <popup:SfPopup.PopupStyle>
                <popup:PopupStyle HeaderBackground="{AppThemeBinding Light=White, Dark=#2D2117}"
                                  HeaderTextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                  PopupBackground="{AppThemeBinding Light=#F8FAFC, Dark=#1C1917}"
                                  Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
            </popup:SfPopup.PopupStyle>
            
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:VehicleCenterViewModel">
                    <Grid Padding="12" RowDefinitions="Auto,*"
                          BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1C1917}">
                        <dataGrid:SfDataGrid Grid.Row="1"
                                             ItemsSource="{Binding ServiceLogPopupRows}"
                                             AutoGenerateColumnsMode="None"
                                             SelectionMode="None"
                                             AllowEditing="False"
                                             ColumnWidthMode="Fill"
                                             HeaderRowHeight="{OnPlatform MacCatalyst=40, WinUI=40, Android=52, iOS=52}"
                                             RowHeight="{OnPlatform WinUI=42, MacCatalyst=42, Android= 46, iOS=46}"
                                             GridLinesVisibility="Both"
                                             HeaderGridLinesVisibility="Both"
                                             VerticalScrollBarVisibility="Always"
                                             HorizontalScrollBarVisibility="Never">
                            <dataGrid:SfDataGrid.DefaultStyle>
                                <dataGrid:DataGridStyle HeaderRowBackground="{AppThemeBinding Light=#F8FAFC, Dark=#2D2117}"
                                                        HeaderRowTextColor="{AppThemeBinding Light=#475569, Dark=#9DB7D2}"
                                                        RowBackground="{AppThemeBinding Light=#FFFFFF, Dark=#1C1917}"
                                                        RowTextColor="{AppThemeBinding Light=#1E293B, Dark=#EDF6FF}"
                                                        GridLineColor="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
                            </dataGrid:SfDataGrid.DefaultStyle>
                            <dataGrid:SfDataGrid.Columns>
                                <dataGrid:DataGridTextColumn MappingName="Date" HeaderText="DATE" Width="120"/>
                                <dataGrid:DataGridTextColumn MappingName="ServiceType" HeaderText="SERVICE TYPE" />
                                <dataGrid:DataGridTextColumn MappingName="Mileage" HeaderText="Odameter" Width="120"/>
                                <dataGrid:DataGridTextColumn MappingName="Amount" HeaderText="COST" Width="100"/>
                                <dataGrid:DataGridTemplateColumn HeaderText="" Width="72">
                                    <dataGrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:ServiceRecord">
                                            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                                <Label Text="&#xE3C9;" FontFamily="MaterialIcons" FontSize="18"
                                                       TextColor="{AppThemeBinding Light=#B45309, Dark=#D97706}" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.EditServiceCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label Text="&#xE872;" FontFamily="MaterialIcons" FontSize="18"
                                                       TextColor="#EF4444" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference RootGrid}, Path=BindingContext.DeleteServiceCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </dataGrid:DataGridTemplateColumn.CellTemplate>
                                </dataGrid:DataGridTemplateColumn>
                            </dataGrid:SfDataGrid.Columns>
                        </dataGrid:SfDataGrid>
                    </Grid>
                </DataTemplate>
            </popup:SfPopup.ContentTemplate>
        </popup:SfPopup>

        <popup:SfPopup IsOpen="{Binding IsFuelSpendingPopupVisible}"
                       HeaderTitle="Fuel Spending"
                       ShowHeader="True"
                       ShowFooter="False"
                       ShowCloseButton="True"
                       WidthRequest="760"
                       Margin="12"
                       HeightRequest="{Binding FuelPopupHeight}"
                       StaysOpen="False">
            <popup:SfPopup.PopupStyle>
                <popup:PopupStyle HeaderBackground="{AppThemeBinding Light=White, Dark=#2D2117}"
                                  HeaderTextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                  PopupBackground="{AppThemeBinding Light=#F8FAFC, Dark=#1C1917}"
                                  Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3D2E24}"/>
            </popup:SfPopup.PopupStyle>
            <popup:SfPopup.ContentTemplate>
                <DataTemplate x:DataType="vm:VehicleCenterViewModel">
                    <Grid Padding="12" RowDefinitions="Auto,*"
                          BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1C1917}">
                        <dataGrid:SfDataGrid Grid.Row="1"
                                             ItemsSource="{Binding FuelPopupRows}"
                                             AutoGenerateColumnsMode="None"
                                             SelectionMode="None"
                                             AllowEditing="False"
